[Unit]
Description=RTKBase Tcp
#After=network-online.target
#Wants=network-online.target
#Requires=network-online.target
# Tie this service's lifecycle to the GNSS device node itself: str2str's own
# serial reconnect logic doesn't reliably recover from a USB replug (it can
# get stuck printing "waiting..." forever without ever exiting, which means
# Restart=on-failure below never fires). BindsTo+After makes systemd stop
# this unit the moment /dev/ttyGNSS disappears, and the SYSTEMD_WANTS
# property set on that device in 91-gnss.rules starts it fresh again the
# moment the device reappears (possibly under a new /dev/ttyACM*).
BindsTo=dev-ttyGNSS.device
After=dev-ttyGNSS.device
Wants=str2str_file.service

[Service]
Type=simple
SyslogIdentifier=str2str_tcp
User={user}
ExecStart={script_path}/run_cast.sh in_serial out_tcp
Restart=on-failure
RestartSec=30
#Limiting log to 1 msg per minute
LogRateLimitIntervalSec=1 minute
LogRateLimitBurst=1
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={script_path}

[Install]
WantedBy=multi-user.target
