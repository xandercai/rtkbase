[Unit]
Description=RTKBase File - Log data
# BindsTo (not just Requires) so this also stops whenever str2str_tcp.service
# stops or restarts - e.g. when the GNSS device gets replugged and
# str2str_tcp.service is bound-restarted by dev-ttyGNSS.device (see that
# unit's comment). Otherwise this would keep its stale TCP connection open
# and never notice the input side came back.
BindsTo=str2str_tcp.service
After=str2str_tcp.service

[Service]
Type=simple
SyslogIdentifier=str2str_file
User={user}
ExecStart={script_path}/run_cast.sh in_tcp out_file
Restart=on-failure
RestartSec=30
#Limiting log to 1 msg per minute
LogRateLimitIntervalSec=1 minute
LogRateLimitBurst=1
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={script_path}

[Install]
WantedBy=multi-user.target
