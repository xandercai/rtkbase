#U-Blox F9P
# TAG+="systemd" + SYSTEMD_WANTS makes systemd (re)start str2str_tcp.service
# every time this device node appears - the counterpart to the
# BindsTo=dev-ttyGNSS.device in unit/str2str_tcp.service that stops it the
# moment the node disappears. Without this, a USB replug leaves str2str_tcp
# wedged on the old (now-gone) device forever.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", SYMLINK+="ttyGNSS", TAG+="systemd", ENV{SYSTEMD_WANTS}+="str2str_tcp.service"

#Unicore UM980/UM982 behind a Prolific PL2303 USB-serial bridge (067b:23a3).
# It shows up as a plain /dev/ttyUSBn, and the LTE modems (SIM7600, Teltonika)
# also create ttyUSB0..4, so the number isn't stable across boots - pin it to
# ttyGNSS like the receivers above, which is also what str2str_tcp.service's
# BindsTo=dev-ttyGNSS.device waits for. PL2303 bridges usually have no serial
# number, so this assumes it's the only PL2303 on the board.
SUBSYSTEM=="tty", ATTRS{idVendor}=="067b", ATTRS{idProduct}=="23a3", GROUP="dialout", SYMLINK+="ttyGNSS", TAG+="systemd", ENV{SYSTEMD_WANTS}+="str2str_tcp.service"

#Septentrio
SUBSYSTEM=="tty", ATTRS{idVendor}=="152a", ATTRS{idProduct}=="85c0", ENV{USB_TYPE}="152a:85c0"
ENV{USB_TYPE}=="152a:85c0", SUBSYSTEM=="tty", ATTRS{bInterfaceNumber}=="02", GROUP="dialout", SYMLINK+="ttyGNSS", TAG+="systemd", ENV{SYSTEMD_WANTS}+="str2str_tcp.service"
ENV{USB_TYPE}=="152a:85c0", SUBSYSTEM=="tty", ATTRS{bInterfaceNumber}=="04", MODE="0660", GROUP="dialout", SYMLINK+="ttyGNSS_CTRL"
