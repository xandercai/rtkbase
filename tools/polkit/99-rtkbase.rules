polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
       RegExp('str2str_[A-Za-z0-9]+.service').test(action.lookup("unit")) === true &&
       subject.isInGroup("rtkbase"))
       {
         return polkit.Result.YES;
       }
    });

polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
       RegExp('rtkbase_[A-Za-z0-9]+.service').test(action.lookup("unit")) === true &&
       subject.isInGroup("rtkbase"))
       {
         return polkit.Result.YES;
       }
    });

// lte_on.sh/lte_off.sh (run as the rtkbase user, not root) start/stop these
// two units when the LTE radio goes into/out of airplane mode. Without this
// rule, that systemctl call needs interactive polkit auth, which works when
// a human runs the script by hand over SSH but silently fails when the
// lte_modem_on.timer/lte_modem_off.timer fire unattended (no session to
// prompt).
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
       (action.lookup("unit") == "tailscaled.service" ||
        action.lookup("unit") == "tailscale_watchdog.timer") &&
       subject.isInGroup("rtkbase"))
       {
         return polkit.Result.YES;
       }
    });